# Frontend build configuration. Only public values belong here — Vite embeds VITE_* variables in the
# JavaScript bundle that every visitor downloads. Never put API keys or secrets in frontend env files.

# Production backend origin (no trailing slash). Leave unset for local development: the Vite dev server
# proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=
