# IntelliDoc — optional Gemini configuration.
# Copy to backend/.env and add your key. Without a key IntelliDoc runs fully locally.
# When enabled, extracted text passages from uploaded PDFs, your objective and your questions are sent
# to Google's Gemini API.
GEMINI_API_KEY=
GEMINI_ENABLED=true

# Generation: verified to return text + valid JSON (2026-11-17). The fallback is tried once if the
# primary is overloaded or unavailable. Run `python -m scripts.gemini_smoke` after changing these.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional tuning
GEMINI_EMBEDDING_DIM=768
GEMINI_TIMEOUT_S=30
# Retries per model for transient errors (500/503/504/timeouts, short 429 waits), 0–4.
GEMINI_MAX_RETRIES=2
# Soft cap on Gemini requests per server process per day (protects free-tier quota).
GEMINI_DAILY_REQUEST_LIMIT=400
