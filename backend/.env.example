# IntelliDoc — optional Gemini configuration.
# Copy to backend/.env and add your key. Without a key IntelliDoc runs fully locally.
# When enabled, extracted passages from uploaded PDFs and your objective are sent to Google's Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_ENABLED=true

# Optional tuning
GEMINI_EMBEDDING_DIM=768
GEMINI_TIMEOUT_S=30
# Soft cap on Gemini requests per server process per day (protects free-tier quota).
GEMINI_DAILY_REQUEST_LIMIT=400
